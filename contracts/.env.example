# Arc testnet (Circle's L1 — USDC is the native gas token)
ARC_RPC_URL=https://rpc.testnet.arc.network
# Deployer/treasury private key (testnet only — never commit the real .env).
# Fund this address with testnet USDC from https://faucet.circle.com (USDC = gas on Arc).
PRIVATE_KEY=0xyour_testnet_deployer_key
# Stablecoin defaults to Arc's canonical Circle USDC; override only if needed.
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
